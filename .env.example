# Cloudflare 部署（用于静态导出 + OpenNext）
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# API 服务器地址（生产环境必须设置！）
# 格式：https://ws.your-domain.com 或 http://localhost:3001
# 不设置则默认 fallback 到 http://localhost:3001
# NEXT_PUBLIC_WS_URL=https://ws.arknights-guess.online
