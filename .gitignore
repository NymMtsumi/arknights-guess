# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!server/.env.example

# sensitive project info
PROJECT_CREDENTIALS.md
HANDOFF-CONFIDENTIAL.md

# vercel
.vercel

# typescript
*.tsbuildinfo

# raw game data (14MB, not needed for build)
scripts/character_table_raw.json
cloudflared-linux-amd64

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# SQLite databases — NEVER commit (catch-all)
*.db
*.db-shm
*.db-wal
*.db-journal
data.db.bak-*

# session exports (too large, not code)
session-user-messages.md

# external demo repos (avoid accidental gitlink commits)
card-hover/
css-effects/
cyberpunk-lp/
party-mode.tar.gz
party-mode.zip

# python
__pycache__/
*.pyc
