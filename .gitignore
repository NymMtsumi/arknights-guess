# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# sensitive project info
PROJECT_CREDENTIALS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw game data (14MB, not needed for build)
scripts/character_table_raw.json
cloudflared-linux-amd64

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# SQLite database (contains user data, do not commit)
server/data.db
server/data.db-shm
server/data.db-wal
package-lock.json
