# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!server/.env.example

# sensitive project info
PROJECT_CREDENTIALS.md
HANDOFF-CONFIDENTIAL.md

# 内部运维文档 —— 含服务器地址/项目路径/密钥位置，不进公开仓库。
# ⚠️ 只挡新增，已有的历史提交仍需单独处理（见仓库 README 的说明）。
/CLAUDE.md
/HANDOFF.md
/REQUIREMENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo

# raw game data (14MB, not needed for build)
scripts/character_table_raw.json
cloudflared-linux-amd64

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# SQLite databases — NEVER commit (catch-all)
*.db
*.db-shm
*.db-wal
*.db-journal
data.db.bak-*

# session exports (too large, not code)
session-user-messages.md

# external demo repos (avoid accidental gitlink commits)
card-hover/
css-effects/
cyberpunk-lp/
party-mode.tar.gz
party-mode.zip

# python
__pycache__/
*.pyc

# 本地截图产物（验证/对比用，不是代码）
/.shots/
/tests/_shots/

# 一次性探针脚本（本地诊断用，跑完即弃）。
# ⚠️ 下划线前缀的文件**默认**不入库，但有两类是长期基建，必须显式放行 ——
#    漏放行不会在本地报错（文件就在磁盘上），只会在**全新 checkout 的 CI runner 上**
#    ERR_MODULE_NOT_FOUND。所以每加一个依赖下划线助手的测试，都要回到这里对一遍：
#      - tests/_dns-preload.cjs  沙箱 DNS 垫片（本地 MX 校验假失败的规避）
#      - tests/_ts-load.mjs      直接加载 .ts 模块的加载器
#        （依赖它的有两处：tests/turtle-store-test.mjs，以及 review gate 的哨兵
#          scripts/check-attr-contract.mjs —— 漏放行会让**部署 gate 自己**在 CI 上挂掉）
/tests/_*.mjs
!/tests/_ts-load.mjs
