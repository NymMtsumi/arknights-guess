# JWT 签名密钥（生产环境务必修改为强随机字符串！openssl rand -hex 32）
JWT_SECRET=change-this-to-a-random-secret-string

# QQ 邮箱 SMTP（用于发送验证邮件）
SMTP_USER=your-qq-email@qq.com
SMTP_PASS=your-qq-smtp-password
# 发件人地址（可选，默认 "明日方舟猜干员" <noreply@arknights-guess.online>）
# SMTP_FROM="明日方舟猜干员" <your-email@qq.com>

# 网站 URL（用于生成验证链接）
SITE_URL=https://www.arknights-guess.online

# CORS 允许的前端来源（逗号分隔，用于 credentialed 请求）
ALLOWED_ORIGINS=https://www.arknights-guess.online,https://arknights-guess.pages.dev,http://localhost:3000

# 服务器端口（可选，默认 3001）
# PORT=3001

# 部署 Webhook Token（可选，用于 GitHub Actions 自动部署）
# DEPLOY_TOKEN=your-deploy-token

# Cloudflare API（可选，用于清除缓存等操作）
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# PM2 进程名（可选，默认 liyiba）
# PM2_APP_NAME=liyiba

# 本地开发专用（仅 NODE_ENV=development 时生效，双开关防误配置）
# NODE_ENV=development
# ALLOW_DEV_FALLBACK=1
